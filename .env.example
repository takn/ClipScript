# Commercial transcription (AssemblyAI accepts common video + audio formats)
ASSEMBLYAI_API_KEY=

# Semantic embeddings (falls back to local hashing when unset)
OPENAI_API_KEY=

# Optional S3 source
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=

# Optional SQLite path (defaults to ./data/transcripts.db)
# SQLITE_PATH=./data/transcripts.db
